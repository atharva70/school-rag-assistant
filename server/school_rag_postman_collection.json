{
  "info": {
    "name": "School RAG Assistant API",
    "description": "Complete collection for School RAG Assistant backend: Auth, Admin, Teacher, Standards, Document RAG Ingestion (PDF -> LangChain chunking -> Embeddings), and SSE Streaming Chat ($vectorSearch).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "teacherToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "studentToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "standardId",
      "value": "",
      "type": "string"
    },
    {
      "key": "documentId",
      "value": "",
      "type": "string"
    },
    {
      "key": "sessionId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:5000/health",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["health"]
        }
      }
    },
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "1.1 Login as Super Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set('adminToken', jsonData.data.token);",
                  "    console.log('Saved adminToken');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@schoolrag.com\",\n  \"password\": \"Admin@123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "1.2 Login as Teacher",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set('teacherToken', jsonData.data.token);",
                  "    console.log('Saved teacherToken');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"teacher.math@school.com\",\n  \"password\": \"TeacherPassword123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "1.3 Login as Student",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set('studentToken', jsonData.data.token);",
                  "    console.log('Saved studentToken');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student1@school.com\",\n  \"password\": \"StudentPassword123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "1.4 Get Current User Profile (/auth/me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Admin Endpoints (SUPER_ADMIN only)",
      "item": [
        {
          "name": "2.1 Create Standard (Grade 10)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data._id) {",
                  "    pm.collectionVariables.set('standardId', jsonData.data._id);",
                  "    console.log('Saved standardId: ' + jsonData.data._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Grade 10\",\n  \"subjects\": [\n    {\n      \"name\": \"Mathematics\",\n      \"code\": \"MATH10\"\n    },\n    {\n      \"name\": \"Science\",\n      \"code\": \"SCI10\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/standards",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "standards"]
            }
          }
        },
        {
          "name": "2.2 Add Subject to Standard",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Physics\",\n  \"code\": \"PHYS10\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/standards/{{standardId}}/subjects",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "standards", "{{standardId}}", "subjects"]
            }
          }
        },
        {
          "name": "2.3 Create Teacher assigned to Standard",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"teacher.math@school.com\",\n  \"password\": \"TeacherPassword123!\",\n  \"standardId\": \"{{standardId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/teachers",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "teachers"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Teacher Endpoints (TEACHER only)",
      "item": [
        {
          "name": "3.1 Create Student (Assigned to Teacher's standardId)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{teacherToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student1@school.com\",\n  \"password\": \"StudentPassword123!\",\n  \"standardId\": \"{{standardId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/teacher/students",
              "host": ["{{baseUrl}}"],
              "path": ["teacher", "students"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Standards (Any Authenticated User)",
      "item": [
        {
          "name": "4.1 Get All Standards",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/standards",
              "host": ["{{baseUrl}}"],
              "path": ["standards"]
            }
          }
        },
        {
          "name": "4.2 Get Standard by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/standards/{{standardId}}",
              "host": ["{{baseUrl}}"],
              "path": ["standards", "{{standardId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "5. Documents & RAG Ingestion",
      "item": [
        {
          "name": "5.1 Upload PDF Document (TEACHER only)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.id) {",
                  "    pm.collectionVariables.set('documentId', jsonData.data.id);",
                  "    console.log('Saved documentId: ' + jsonData.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{teacherToken}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": [],
                  "description": "Select any PDF textbook or notes file (max 15MB)"
                },
                {
                  "key": "standardId",
                  "value": "{{standardId}}",
                  "type": "text"
                },
                {
                  "key": "subjectName",
                  "value": "Mathematics",
                  "type": "text"
                },
                {
                  "key": "title",
                  "value": "Chapter 1 - Real Numbers",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/documents/upload",
              "host": ["{{baseUrl}}"],
              "path": ["documents", "upload"]
            }
          }
        },
        {
          "name": "5.2 Get Documents (Student - automatically grade filtered)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/documents",
              "host": ["{{baseUrl}}"],
              "path": ["documents"]
            }
          }
        },
        {
          "name": "5.3 Get Documents filtered by Subject",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/documents?subjectName=Mathematics",
              "host": ["{{baseUrl}}"],
              "path": ["documents"],
              "query": [
                {
                  "key": "subjectName",
                  "value": "Mathematics"
                }
              ]
            }
          }
        },
        {
          "name": "5.4 Delete Document and Chunks (TEACHER only)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{teacherToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/documents/{{documentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["documents", "{{documentId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "6. Chat & Vector Search (SSE Streaming)",
      "item": [
        {
          "name": "6.1 Ask Question (Streams SSE & Returns Citations)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Note: Postman captures the final event stream body or prints events.",
                  "// The sessionId will be emitted in the 'citations' and 'done' SSE events."
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              },
              {
                "key": "Accept",
                "value": "text/event-stream"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"subjectName\": \"Mathematics\",\n  \"question\": \"Explain Euclid's division lemma with an example.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/chat",
              "host": ["{{baseUrl}}"],
              "path": ["chat"]
            }
          }
        },
        {
          "name": "6.2 Continue Conversation with sessionId",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              },
              {
                "key": "Accept",
                "value": "text/event-stream"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"subjectName\": \"Mathematics\",\n  \"question\": \"Can you provide another practice question on this topic?\",\n  \"sessionId\": \"{{sessionId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/chat",
              "host": ["{{baseUrl}}"],
              "path": ["chat"]
            }
          }
        }
      ]
    }
  ]
}
